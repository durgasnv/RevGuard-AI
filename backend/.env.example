# RevGuard-AI environment configuration
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.

# Razorpay API keys (test mode). Omit to run fully in simulator mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook HMAC secret. When set, /webhooks/razorpay rejects unsigned or
# bad-signature requests with 401. Leave empty in local simulator demos.
RAZORPAY_WEBHOOK_SECRET=

# OpenAI-compatible LLM for diagnosis. Omit to use the deterministic
# heuristic fallback (fully functional, zero cost).
OPENAI_API_KEY=
OPENAI_BASE_URL=
DIAGNOSIS_MODEL=gpt-4o-mini
